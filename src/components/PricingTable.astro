---
import { PRICING, PRICING_NOTE } from '../lib/pricing';

interface Props {
  heading?: string;
}

const { heading = 'Indicative Cargo Rates (AED)' } = Astro.props;
---

<div class="bg-white border border-gray-100 rounded-xl shadow-sm p-6">
  <h2 class="text-xl font-semibold text-cargo-blue mb-3">{heading}</h2>
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm">
      <caption class="sr-only">Cargo shipping rates in AED per kilogram or per item</caption>
      <thead>
        <tr class="border-b border-gray-200 text-left">
          <th class="py-2 pr-4" scope="col">Item Type</th>
          <th class="py-2" scope="col">Price (AED)</th>
        </tr>
      </thead>
      <tbody>
        {PRICING.map((row) => (
          <tr class="border-b border-gray-100">
            <td class="py-2 pr-4">{row.item}</td>
            <td class="py-2 font-medium">{row.price}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-sm text-gray-500">{PRICING_NOTE}</p>
</div>
